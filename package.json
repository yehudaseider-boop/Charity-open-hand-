{
  "name": "nediv-lev",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "bash scripts/local-db-up.sh",
    "test": "vitest run",
    "test:no-db": "SKIP_DB_TESTS=yes vitest run --exclude 'tests/*-db.test.ts' --exclude tests/rls.test.ts --exclude tests/onboarding.test.ts",
    "typecheck": "next typegen && tsc --noEmit -p tsconfig.typecheck.json",
    "db:start": "supabase start -x realtime,postgres-meta,studio,imgproxy,vector,logflare,edge-runtime,supavisor",
    "db:reset": "supabase db reset && npm run db:seed",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "receipts": "tsx --env-file=.env.local scripts/issue-receipts.ts"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/heebo": "^5.3.0",
    "@sparticuz/chromium": "153.0.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "next": "16.4.2",
    "playwright-core": "^1.64.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@hebcal/core": "^6.14.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "jsdom": "^29.1.1",
    "pg": "^8.23.1",
    "supabase": "^2.119.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
