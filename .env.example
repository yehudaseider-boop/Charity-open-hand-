# Copy this file to .env.local and fill in the values.
# For local development, `npx supabase status` prints these.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SECRET_KEY=
# Server-only. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes encrypted bank, ID and tax numbers unreadable. Keep a secure backup.
ENCRYPTION_KEY=
