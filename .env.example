# Copy this file to .env.local and fill in the values.
# For local development, `npx supabase status` prints these.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SECRET_KEY=
# Server-only. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes encrypted bank, ID and tax numbers unreadable. Keep a secure backup.
ENCRYPTION_KEY=

# Payment gateway: "test" (local stand-in, never in production) or "paystack".
PAYMENT_GATEWAY=test
# Test gateway signing secret (any long random string, local only).
TEST_GATEWAY_SECRET=
# Paystack secret key (sk_test_... in test mode). Server-only.
PAYSTACK_SECRET_KEY=
# Split payments (each donation paid straight into the chosen charity's own account).
# "yes" only after splitting is confirmed in Paystack's test mode. Off, Paystack takes no donations.
PAYSTACK_SPLITS=
# Local only: makes the test gateway behave like a splitting one (charities then need a connected test account).
TEST_GATEWAY_SPLITS=
# Local only: a pretend card fee for the test gateway, in parts per million. Never a real rate.
TEST_GATEWAY_FEE_PPM=
# Public address of the site, used for gateway return links.
SITE_URL=http://127.0.0.1:3000
# The header our host guarantees carries the visitor's address (for rate limits), e.g. x-real-ip.
# Set it once hosting is final (go-live checklist). Without it, the last X-Forwarded-For entry is used.
CLIENT_IP_HEADER=
# Where Givezy's own alerts go (your address): new charity applications, a charity changing its public page,
# chargebacks, and the daily "needs a person" email. Leave empty and they only reach the server log.
ADMIN_NOTIFY_EMAIL=
# Lets the phone app start once-off gifts (/api/app/*). Leave unset until in-app giving is chosen.
APP_GIVING=
# Saving a card for once-off gifts in the app. Off unless "yes" (also needs APP_GIVING=yes). Keep it off until the go-live checklist item is done.
SAVED_CARDS=
# Local machine only: lets the test gateway run under `next start`. NEVER set this on a real server.
ALLOW_TEST_GATEWAY=

# Secret for the scheduled jobs (a long random string). Without it every job is off.
# vercel.json runs /api/jobs/daily once a day (monthly collection, deposit report, safety checks); Vercel sends this
# secret as "Authorization: Bearer <this>" when it is set as an environment variable. The separate
# /api/jobs/monthly-giving and /api/jobs/payouts take the same secret, for an hourly collection on a bigger plan.
CRON_SECRET=

# Yearly s18A receipts job (npm run receipts). Off until the attorney confirms the wording.
RECEIPTS_ENABLED=
RECEIPT_WORDING_CONFIRMED=
# A Chrome or Chromium executable, used to print receipt PDFs on your own machine (npm run receipts). Leave empty
# on Vercel: the website then uses its own bundled Chromium.
CHROME_PATH=
# Only for containers that cannot run Chrome with its sandbox. Never set this on a normal machine.
CHROME_NO_SANDBOX=

# Email: "console" (default, only logs) or "resend".
EMAIL_TRANSPORT=
RESEND_API_KEY=
# For example: Givezy <receipts@your-domain.co.za>
EMAIL_FROM=
# Test sites only: email goes to these addresses or domains (comma-separated) and nowhere else,
# so a test checkout can never email a real donor. Leave unset on the live site.
EMAIL_ALLOWLIST=
