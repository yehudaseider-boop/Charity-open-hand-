# Copy this file to .env.local and fill in the values.
# For local development, `npx supabase status` prints these.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Never expose this to the browser.
SUPABASE_SECRET_KEY=
# Server-only. 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing this key makes encrypted bank, ID and tax numbers unreadable. Keep a secure backup.
ENCRYPTION_KEY=

# Payment gateway: "test" (local stand-in, never in production) or "paystack".
PAYMENT_GATEWAY=test
# Test gateway signing secret (any long random string, local only).
TEST_GATEWAY_SECRET=
# Paystack secret key (sk_test_... in test mode). Server-only.
PAYSTACK_SECRET_KEY=
# Public address of the site, used for gateway return links.
SITE_URL=http://127.0.0.1:3000
# Local machine only: lets the test gateway run under `next start`. NEVER set this on a real server.
ALLOW_TEST_GATEWAY=

# Yearly s18A receipts job (npm run receipts). Off until the attorney confirms the wording.
RECEIPTS_ENABLED=
RECEIPT_WORDING_CONFIRMED=
# A Chrome or Chromium executable, used to print receipt PDFs. Only needed on the machine that runs the job.
CHROME_PATH=
# Only for containers that cannot run Chrome with its sandbox. Never set this on a normal machine.
CHROME_NO_SANDBOX=

# Email: "console" (default, only logs) or "resend".
EMAIL_TRANSPORT=
RESEND_API_KEY=
# For example: NEDIV lev <receipts@your-domain.co.za>
EMAIL_FROM=
