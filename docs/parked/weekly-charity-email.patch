+/**
+ * The weekly email's run (22/11/2026), with the database and email faked: only approved charities, owners and admins by
+ * default (others when they switch it on, anyone can switch theirs off), never twice for the same charity, person and
+ * week (a second run, a run after a crash part-way, two runs at once), a send that surely didn't go is tried again,
+ * one that may have gone is not, the switch and the missing migration send nothing, and the stop link switches off
+ * exactly one person's email for one charity.
+ */
+import { beforeEach, describe, expect, it, vi } from "vitest";
+
+vi.mock("server-only", () => ({}));
+
+type Row = Record<string, unknown>;
+let tables: Record<string, Row[]> = {};
+let missing: { table?: string; column?: string } = {};
+let sendMode: "ok" | "surely" | "maybe" | "skipped" = "ok";
+let transportName = "resend";
+const sent: { to: string; subject: string; text: string; headers?: Record<string, string> }[] = [];
+
+function q(table: string) {
+  const filters: ((r: Row) => boolean)[] = [];
+  let op: "select" | "update" | "delete" = "select";
+  let patch: Row = {};
+  let cols = "";
+  let range: [number, number] | null = null;
+  const b: Record<string, unknown> = {};
+  const rows = () => (tables[table] ??= []);
+  const err = () => {
+    if (missing.table === table) return { code: "PGRST205", message: "not in the schema cache" };
+    if (missing.column && table === "charity_admins" && (cols.includes(missing.column) || missing.column in patch)) return { code: "42703", message: "column does not exist" };
+    return null;
+  };
+  b.select = (c = "") => ((cols = op === "select" ? c : cols), b);
+  b.eq = (c: string, v: unknown) => (filters.push((r) => r[c] === v), b);
+  b.in = (c: string, v: unknown[]) => (filters.push((r) => v.includes(r[c])), b);
+  b.gte = (c: string, v: string) => (filters.push((r) => typeof r[c] === "string" && Date.parse(r[c] as string) >= Date.parse(v)), b);
+  b.lt = (c: string, v: string) => (filters.push((r) => typeof r[c] === "string" && Date.parse(r[c] as string) < Date.parse(v)), b);
+  b.not = (c: string) => (filters.push((r) => r[c] !== null && r[c] !== undefined), b);
+  b.match = (m: Row) => (filters.push((r) => Object.entries(m).every(([k, v]) => r[k] === v)), b);
+  b.order = () => b;
+  b.limit = () => b;
+  b.range = (from: number, to: number) => ((range = [from, to]), b);
+  b.update = (p: Row) => ((op = "update"), (patch = p), b);
+  b.delete = () => ((op = "delete"), b);
+  b.insert = async (row: Row) => {
+    if (missing.table === table) return { error: { code: "PGRST205", message: "missing" } };
+    if (table === "charity_weekly_emails" && rows().some((r) => r.charity_id === row.charity_id && r.user_id === row.user_id && r.week_start === row.week_start)) {
+      return { error: { code: "23505", message: "duplicate key" } };
+    }
+    rows().push({ outcome: "sending", ...row });
+    return { error: null };
+  };
+  const run = () => {
+    const e = err();
+    if (e) return { data: null, error: e };
+    const hit = rows().filter((r) => filters.every((f) => f(r)));
+    if (op === "update") for (const r of hit) Object.assign(r, patch);
+    if (op === "delete") tables[table] = rows().filter((r) => !hit.includes(r));
+    const data = range ? hit.slice(range[0], range[1] + 1) : hit;
+    return { data: data.map((r) => ({ ...r })), error: null };
+  };
+  b.maybeSingle = async () => {
+    const r = run();
+    return { data: r.data?.[0] ?? null, error: r.error };
+  };
+  b.then = (ok: (v: unknown) => unknown, bad?: (e: unknown) => unknown) => Promise.resolve(run()).then(ok, bad);
+  return b;
+}
+
+vi.mock("@/lib/supabase/admin", () => ({ createAdminClient: () => ({ from: q }) }));
+vi.mock("@/lib/email", () => {
