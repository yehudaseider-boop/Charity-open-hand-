@@ -0,0 +1,387 @@
+import "server-only";
+import { createHash, randomBytes } from "node:crypto";
+import { thisTaxYear } from "@/lib/charity/dashboard";
+import { EmailMaybeSent, getEmailTransport, maskEmail } from "@/lib/email";
+import { oneClickStopUrl } from "@/lib/email/headers";
+import { createAdminClient } from "@/lib/supabase/admin";
+import { readPages } from "./paged";
+import { isRole, type Role } from "./permissions";
+import {
+  firstPayments,
+  giftTotals,
+  isSendDay,
+  monthlyMoves,
+  quietNextStep,
+  reportWeek,
+  s18aWaiting,
+  weeklyEmail,
+  weeklyEmailSwitchedOn,
+  weeklyRecipients,
+  wantsWeekly,
+  type GiftRow,
+  type MonthlyMoveRow,
+  type ReportWeek,
+  type WeekFigures,
+  type WeeklyMember,
+} from "./weekly-summary";
+
+/**
+ * The weekly email's database side (Yehuda, 22/11/2026; the rules and words are in ./weekly-summary.ts). Run by the
+ * daily job; reads and writes with the service role, always filtered by the charity. Never sends twice for the same
+ * charity, person and week: each email's row in charity_weekly_emails is claimed (inserted) before it is sent, and the
+ * primary key refuses a second claim. Tolerates migration 20261122000003 not having run yet: then nothing is sent and
+ * one line is logged.
+ */
+
+const db = () => createAdminClient();
+const sha = (s: string) => createHash("sha256").update(s).digest("hex");
+
+/** Each email waits at most this long for the email service, so the daily job ends inside its minute. */
+export const WEEKLY_SEND_TIMEOUT_MS = 4_000;
+
+/** The table or column isn't there yet (the migration hasn't run). */
+export const notSetUp = (e: { code?: string } | null | undefined) => ["PGRST205", "42P01", "PGRST204", "42703"].includes(e?.code ?? "");
+
+export type WeeklyRun = {
+  /** Why nothing was tried today: the switch is off, it isn't a send day, email isn't set up, or the migration hasn't run. */
+  off?: "switch" | "not_today" | "email" | "not_set_up";
+  week?: string;
+  sent: number;
+  /** The email service may have taken it (cut off mid-send): counted once, never sent again. */
+  maybeSent: number;
+  /** Nothing left (not on the test site's allowed list, an erased address): not tried again this week. */
+  skipped: number;
+  /** Surely not sent: released, so a later run (the next day, up to Wednesday) tries again. */
+  failed: number;
+  /** People not reached before the deadline: tried by tomorrow's run (up to Wednesday). */
+  leftOver: number;
+};
+
+type CharityRow = {
+  id: string;
+  name_en: string;
+  slug: string;
+  is_s18a: boolean;
+  mandate_signed_at: string | null;
+  logo_path: string | null;
+  cover_path: string | null;
+  description_en: string | null;
+  funds_use_en: string | null;
+};
+
+/**
+ * The daily job's part, last in its minute: on a send day, every approved charity's team members who want the email
+ * and haven't had it for last week. Starts nothing new after `deadline`. Never throws for one charity or person.
+ */
+export async function runWeeklySummaries(now: Date, deadline: number, env: Record<string, string | undefined> = process.env): Promise<WeeklyRun> {
+  const out: WeeklyRun = { sent: 0, maybeSent: 0, skipped: 0, failed: 0, leftOver: 0 };
+  if (!weeklyEmailSwitchedOn(env)) return { ...out, off: "switch" };
+  if (!isSendDay(now)) return { ...out, off: "not_today" };
+  const transport = getEmailTransport(env);
+  // With email not set up nothing would leave: claim nothing, so the week is still there once it is.
+  if (transport.name === "console") return { ...out, off: "email" };
+  const week = reportWeek(now);
+  out.week = week.start;
+
+  const done = await alreadyClaimed(week.start);
+  if (done === null) {
+    console.info("[weekly email] not set up yet (migration 20261122000003_charity_weekly_email.sql): nothing sent");
+    return { ...out, off: "not_set_up" };
+  }
+  const charities = await readPages<CharityRow>((from, to) =>
+    db()
+      .from("charities")
+      .select("id, name_en, slug, is_s18a, mandate_signed_at, logo_path, cover_path, description_en, funds_use_en")
+      // Only charities whose page is live: never a draft, one waiting for review, sent back or suspended.
+      .eq("status", "approved")
+      .order("id")
+      .range(from, to),
+  );
+  const site = (env.SITE_URL ?? "").replace(/\/+$/, "");
+
+  for (const charity of charities) {
+    let members: (WeeklyMember & { userId: string })[];
+    try {
+      members = await teamFor(charity.id);
+    } catch (e) {
+      if (notSetUp(e as { code?: string })) {
+        console.info("[weekly email] not set up yet (charity_admins.weekly_email missing): nothing sent");
+        return { ...out, off: "not_set_up" };
+      }
+      console.error("[weekly email] couldn't read a charity's team", e instanceof Error ? e.message : e);
+      out.failed += 1;
+      continue;
+    }
+    const due = weeklyRecipients(members).filter((m) => !done.has(`${charity.id}:${m.userId}`));
+    if (!due.length) continue;
+    if (Date.now() >= deadline) {
+      out.leftOver += due.length;
+      continue;
+    }
+    let figures: WeekFigures;
+    try {
+      figures = await loadFigures(charity, week, now);
+    } catch (e) {
+      // Nothing claimed for this charity: tomorrow's run (up to Wednesday) tries again.
+      console.error("[weekly email] couldn't read a charity's week", e instanceof Error ? e.message : e);
+      out.failed += due.length;
+      continue;
+    }
+    const dashboardUrl = `${site}/charity-admin/${charity.id}`;
+    const nextStep = quietNextStep(charity, dashboardUrl, `${site}/c/${charity.slug}`);
+    for (const m of due) {
+      if (Date.now() >= deadline) {
+        out.leftOver += 1;
+        continue;
+      }
+      const token = randomBytes(32).toString("base64url");
+      // The claim comes first: a second run, or one after a crash, finds the row and sends nothing.
+      const claim = await db().from("charity_weekly_emails").insert({ charity_id: charity.id, user_id: m.userId, week_start: week.start, stop_token_hash: sha(token) });
+      if (claim.error) {
+        if (claim.error.code === "23505") continue; // already claimed by another run
+        if (notSetUp(claim.error)) return { ...out, off: "not_set_up" };
+        console.error("[weekly email] couldn't claim a send", claim.error.message);
+        out.failed += 1;
+        continue;
+      }
+      const message = weeklyEmail({
+        to: m.email!,
+        charityName: charity.name_en,
+        week,
+        figures,
+        nextStep,
+        dashboardUrl,
+        stopUrl: `${site}/weekly-email/stop?t=${encodeURIComponent(token)}`,
+        oneClickUrl: site ? oneClickStopUrl(site, "weekly", token) : undefined,
+        siteUrl: site || undefined,
+      });
+      const key = { charity_id: charity.id, user_id: m.userId, week_start: week.start };
+      try {
+        const outcome = await transport.send({ ...message, signal: AbortSignal.timeout(WEEKLY_SEND_TIMEOUT_MS) });
+        await finish(key, outcome === "sent" ? "sent" : "skipped");
+        if (outcome === "sent") out.sent += 1;
+        else out.skipped += 1;
+      } catch (e) {
+        if (e instanceof EmailMaybeSent) {
+          // It may have gone: the row stays, so it is never sent again.
+          out.maybeSent += 1;
+          console.error(`[weekly email] may or may not have gone to ${maskEmail(m.email!)}; not sending again`);
+          await finish(key, "maybe_sent");
+          continue;
+        }
+        // Surely not sent: release the claim so a later run can try again.
+        out.failed += 1;
+        console.error("[weekly email] not sent", e instanceof Error ? e.message : e);
+        const { error } = await db().from("charity_weekly_emails").delete().match(key).eq("outcome", "sending");
+        if (error) console.error("[weekly email] couldn't release a claim (it won't be sent this week)", error.message);
+      }
+    }
+  }
+  return out;
+}
+
+async function finish(key: Record<string, string>, outcome: "sent" | "skipped" | "maybe_sent"): Promise<void> {
+  const { error } = await db().from("charity_weekly_emails").update({ outcome, finished_at: new Date().toISOString() }).match(key);
+  // The claim stays "sending" either way, which is never sent again: nothing is lost but the record of how it went.
+  if (error) console.error("[weekly email] couldn't record a send", error.message);
+}
+
+/** "charity:user" for every email already claimed for this week; null when the send log isn't there yet. */
+async function alreadyClaimed(weekStart: string): Promise<Set<string> | null> {
+  try {
+    const rows = await readPages<{ charity_id: string; user_id: string }>((from, to) =>
+      db().from("charity_weekly_emails").select("charity_id, user_id").eq("week_start", weekStart).order("charity_id").order("user_id").range(from, to),
+    );
+    return new Set(rows.map((r) => `${r.charity_id}:${r.user_id}`));
+  } catch (e) {
+    if (notSetUp(e as { code?: string })) return null;
+    throw e;
+  }
+}
+
+/** The team with each person's role, their own choice and their sign-in email. Throws the database error as it came. */
+async function teamFor(charityId: string): Promise<WeeklyMember[]> {
+  const { data, error } = await db().from("charity_admins").select("user_id, role, weekly_email").eq("charity_id", charityId);
+  if (error) throw error;
+  const ids = (data ?? []).map((m) => m.user_id as string);
+  if (!ids.length) return [];
+  const { data: profiles, error: pError } = await db().from("profiles").select("id, email").in("id", ids);
+  if (pError) throw pError;
+  const emailOf = new Map((profiles ?? []).map((p) => [p.id as string, (p.email as string | null) ?? null]));
+  return (data ?? []).map((m) => ({
+    userId: m.user_id as string,
+    // A role this code doesn't know gets the least, as on the dashboard.
+    role: (isRole(m.role) ? m.role : "viewer") as Role,
+    weeklyEmail: (m.weekly_email as boolean | null) ?? null,
+    email: emailOf.get(m.user_id as string) ?? null,
+  }));
+}
+
+/** Last week's figures and the week before, as the dashboard counts them. */
+export async function loadFigures(charity: Pick<CharityRow, "id" | "is_s18a" | "mandate_signed_at">, week: ReportWeek, now: Date): Promise<WeekFigures> {
+  const id = charity.id;
+  const tax = thisTaxYear(now);
+  const [gifts, monthlyRows, weekPayments, s18a] = await Promise.all([
+    readPages<GiftRow>((from, to) =>
+      db()
+        .from("donations")
+        .select("donor_id, status, amount_cents, refunded_cents, paid_at")
+        .eq("charity_id", id)
+        .eq("status", "paid")
+        .gte("paid_at", week.prevFrom)
+        .lt("paid_at", week.to)
+        .order("id")
+        .range(from, to),
+    ),
+    // Stopped or paused ones changed since the week began (a pause or stop updates the row), so this is a superset.
+    readPages<MonthlyMoveRow>((from, to) =>
+      db()
+        .from("recurring_donations")
+        .select("id, status, paused_at, cancelled_at, updated_at")
+        .eq("charity_id", id)
+        .in("status", ["paused", "cancelled", "failed"])
+        .gte("updated_at", week.from)
+        .order("id")
+        .range(from, to),
+    ),
+    readPages<{ recurring_id: string | null; status: string; paid_at: string | null }>((from, to) =>
+      db()
+        .from("donations")
+        .select("recurring_id, status, paid_at")
+        .eq("charity_id", id)
+        .not("recurring_id", "is", null)
+        .in("status", ["paid", "refunded", "charged_back"])
+        .gte("paid_at", week.from)
+        .lt("paid_at", week.to)
+        .order("id")
+        .range(from, to),
+    ),
+    // The same rule as canIssue18a: confirmed s18A approval and a signed mandate.
+    charity.is_s18a && charity.mandate_signed_at !== null ? loadS18aWaiting(id, tax.taxYear) : Promise.resolve(null),
+  ]);
+  // Every monthly donation that moved: its first payment decides "started", and whether it counts at all.
+  const ids = [...new Set([...monthlyRows.map((r) => r.id), ...weekPayments.map((p) => p.recurring_id!)])];
+  const statusRows = await loadMonthlyStatus(id, weekPayments.map((p) => p.recurring_id!));
+  const payments: { recurring_id: string | null; status: string; paid_at: string | null }[] = [];
+  for (let i = 0; i < ids.length; i += 200) {
+    payments.push(
+      ...(await readPages<{ recurring_id: string | null; status: string; paid_at: string | null }>((from, to) =>
+        db()
+          .from("donations")
+          .select("recurring_id, status, paid_at")
+          .eq("charity_id", id)
+          .in("recurring_id", ids.slice(i, i + 200))
+          .in("status", ["paid", "refunded", "charged_back"])
+          .lt("paid_at", week.to)
+          .order("id")
+          .range(from, to),
+      )),
+    );
+  }
+  const rows = new Map<string, MonthlyMoveRow>();
+  for (const r of [...statusRows, ...monthlyRows]) rows.set(r.id, r);
+  return {
+    week: giftTotals(gifts, week.from, week.to),
+    before: giftTotals(gifts, week.prevFrom, week.from),
+    monthly: monthlyMoves([...rows.values()], firstPayments(payments), week.from, week.to),
+    s18a,
+    taxYearEnd: tax.end,
+  };
+}
+
+/** The status of the monthly donations paid in the week (to count those that started). */
+async function loadMonthlyStatus(charityId: string, ids: string[]): Promise<MonthlyMoveRow[]> {
+  const unique = [...new Set(ids)];
+  const out: MonthlyMoveRow[] = [];
+  for (let i = 0; i < unique.length; i += 200) {
+    const { data, error } = await db().from("recurring_donations").select("id, status, paused_at, cancelled_at, updated_at").eq("charity_id", charityId).in("id", unique.slice(i, i + 200));
+    if (error) throw error;
+    out.push(...((data ?? []) as MonthlyMoveRow[]));
+  }
+  return out;
+}
+
+/** Paid gifts that asked for an s18A receipt and aren't on an issued one, as the s18A receipts page counts them. */
+async function loadS18aWaiting(charityId: string, currentTaxYear: number) {
+  const gifts = await readPages<{ id: string; status: string; wants_18a: boolean; tax_year: number | null; amount_cents: number; refunded_cents: number | null }>((from, to) =>
+    db()
+      .from("donations")
+      .select("id, status, wants_18a, tax_year, amount_cents, refunded_cents")
+      .eq("charity_id", charityId)
+      .eq("status", "paid")
+      .eq("wants_18a", true)
+      .order("id")
+      .range(from, to),
+  );
+  const onIssued = new Set<string>();
+  for (let i = 0; i < gifts.length; i += 200) {
+    const { data, error } = await db()
+      .from("s18a_receipt_donations")
+      .select("donation_id, s18a_receipts!inner(status)")
+      .in("donation_id", gifts.slice(i, i + 200).map((g) => g.id))
+      .eq("s18a_receipts.status", "issued");
+    if (error) throw error;
+    for (const r of data ?? []) onIssued.add(r.donation_id as string);
+  }
+  return s18aWaiting(gifts, onIssued, currentTaxYear);
+}
+
+// --- The person's own setting --------------------------------------------------------------------------------------
+
+/**
+ * Whether the person gets this charity's weekly email, and whether they can change it here. Null: they aren't on the
+ * team (a Givezy admin looking in), or the setting isn't set up yet (the migration hasn't run).
+ */
+export async function ownWeeklyEmail(charityId: string, userId: string): Promise<{ on: boolean; byDefault: boolean } | null> {
+  const { data, error } = await db().from("charity_admins").select("role, weekly_email").eq("charity_id", charityId).eq("user_id", userId).maybeSingle();
+  if (error) {
+    if (notSetUp(error)) return null;
+    throw error;
+  }
+  if (!data) return null;
+  const role: Role = isRole(data.role) ? data.role : "viewer";
+  const choice = (data.weekly_email as boolean | null) ?? null;
+  return { on: wantsWeekly(role, choice), byDefault: choice === null };
+}
+
+export type SetResult = "done" | "not_member" | "not_set_up";
+
+/** The person's own choice for this charity. Only ever their own row: the caller passes the signed-in person's id. */
+export async function setOwnWeeklyEmail(charityId: string, userId: string, on: boolean): Promise<SetResult> {
+  const { data, error } = await db().from("charity_admins").update({ weekly_email: on }).eq("charity_id", charityId).eq("user_id", userId).select("user_id");
+  if (error) {
+    if (notSetUp(error)) return "not_set_up";
+    throw error;
+  }
+  return data?.length ? "done" : "not_member";
+}
+
+const TOKEN = /^[A-Za-z0-9_-]{43}$/;
+
+/**
+ * The stop link (and a mail app's one-click stop): switches off the weekly email for the person and charity that
+ * email went to, and nothing else. False for a link that was never ours.
+ */
+export async function stopWeeklyEmail(token: string): Promise<boolean> {
+  if (!TOKEN.test(token)) return false;
+  const { data, error } = await db().from("charity_weekly_emails").select("charity_id, user_id").eq("stop_token_hash", sha(token)).maybeSingle();
+  if (error) {
+    if (notSetUp(error)) return false;
+    throw error;
+  }
+  if (!data) return false;
+  const { error: uError } = await db().from("charity_admins").update({ weekly_email: false }).eq("charity_id", data.charity_id).eq("user_id", data.user_id);
+  if (uError) throw uError;
+  // Someone no longer on the team gets no weekly email anyway: the link still says done.
+  return true;
+}
+
+/** For the stop page's "Done": the link's person really has it off for that charity (or has left the team). */
+export async function weeklyEmailStopped(token: string): Promise<boolean> {
+  if (!TOKEN.test(token)) return false;
+  const { data, error } = await db().from("charity_weekly_emails").select("charity_id, user_id").eq("stop_token_hash", sha(token)).maybeSingle();
+  if (error || !data) return false;
+  const { data: member, error: mError } = await db().from("charity_admins").select("weekly_email").eq("charity_id", data.charity_id).eq("user_id", data.user_id).maybeSingle();
+  if (mError) return false;
+  return !member || member.weekly_email === false;
+}
diff --git a/src/lib/charity/weekly-summary.ts b/src/lib/charity/weekly-summary.ts
new file mode 100644
index 0000000..04bafcd
--- /dev/null
+++ b/src/lib/charity/weekly-summary.ts
@@ -0,0 +1,322 @@
+/**
+ * The weekly email to a charity's team (Yehuda, 22/11/2026): every Monday morning, last week's figures in a few lines,
+ * with one button to the dashboard. Pure and dependency-free: no database, no clock (the caller passes "now"), so the
+ * week, the figures and the words are tested in one place. The daily job reads the rows and sends
+ * (./weekly-summary-store.ts).
+ *
+ * - The week is Monday 00:00 to Sunday 23:59:59, Johannesburg time (no daylight saving, so always +02:00).
+ * - Figures count gifts the way the dashboard's Overview does (charity_overview): a paid gift counts what is left after
+ *   part refunds, a gift with nothing left or refunded in full is not a gift, and the contribution to Givezy and the
+ *   card charge are never in it. Monthly donations started, stopped and paused follow the Monthly page's own dates
+ *   (charity_monthly_list_full). s18A receipts waiting follow the s18A receipts page (receiptProgress).
+ * - A quiet week (no gifts) still gets a short email with one useful next step. Never guilt wording, never an impact
+ *   figure, never a donor's name, address or amount per donor.
+ */
+import { brandColors as c } from "@/lib/brand-colors";
+import { isoDateInJhb } from "@/lib/dates";
+import { buttonHtml, cardHtml, emailFonts, emailLayout, escHtml, linkify, paragraphHtml } from "@/lib/email/html";
+import type { EmailMessage } from "@/lib/email";
+import { oneClickStopHeaders } from "@/lib/email/headers";
+import { formatRand } from "@/lib/money";
+import { plural } from "@/lib/text";
+import { countsAsGift, leftCents } from "@/lib/donations/what-is-left";
+import type { Role } from "./permissions";
+
+/** The switch: nothing is sent unless WEEKLY_CHARITY_EMAIL is exactly "yes" on the server. */
+export function weeklyEmailSwitchedOn(env: Record<string, string | undefined>): boolean {
+  return env.WEEKLY_CHARITY_EMAIL === "yes";
+}
+
+/**
+ * Monday is the day. The daily job has one minute for everything, so emails it had no time for carry on on Tuesday
+ * and Wednesday (the same week's figures, and never twice: the send log decides). From Thursday that week is left.
+ */
+export const SEND_DAYS = 3;
+
+/** Monday 0 to Sunday 6, for a Johannesburg calendar date (yyyy-mm-dd). */
+export function weekdayOf(isoDate: string): number {
+  const [y, m, d] = isoDate.split("-").map(Number);
+  return (new Date(Date.UTC(y, m - 1, d)).getUTCDay() + 6) % 7;
+}
+
+export function addDays(isoDate: string, days: number): string {
+  const [y, m, d] = isoDate.split("-").map(Number);
+  const t = new Date(Date.UTC(y, m - 1, d));
+  t.setUTCDate(t.getUTCDate() + days);
+  return t.toISOString().slice(0, 10);
+}
+
+/** Johannesburg midnight at the start of a calendar date, as a UTC timestamp for the database. */
+export function jhbMidnight(isoDate: string): string {
+  return new Date(`${isoDate}T00:00:00+02:00`).toISOString();
+}
+
+export type ReportWeek = {
+  /** The Monday the week starts on (yyyy-mm-dd, Johannesburg): also the send log's key. */
+  start: string;
+  /** The Sunday it ends on. */
+  end: string;
+  /** From this moment (inclusive) ... */
+  from: string;
+  /** ... to this one (exclusive): the next Monday's midnight. */
+  to: string;
+  /** The week before starts here (and ends at `from`). */
+  prevFrom: string;
+};
+
+/** The last full week (Monday to Sunday) before today in Johannesburg. */
+export function reportWeek(now: Date): ReportWeek {
+  const today = isoDateInJhb(now);
+  const thisMonday = addDays(today, -weekdayOf(today));
+  const start = addDays(thisMonday, -7);
+  return { start, end: addDays(thisMonday, -1), from: jhbMidnight(start), to: jhbMidnight(thisMonday), prevFrom: jhbMidnight(addDays(start, -7)) };
+}
+
+/** Whether the daily job sends today: Monday, or the two days after for what Monday had no time for. */
+export function isSendDay(now: Date): boolean {
+  return weekdayOf(isoDateInJhb(now)) < SEND_DAYS;
+}
+
+/** "16/11/2026" from "2026-11-16". */
+export const dmy = (isoDate: string) => isoDate.split("-").reverse().join("/");
+
+// --- Who gets it ---------------------------------------------------------------------------------------------------
+
+/** Owners and admins get it unless they switch it off; anyone else in the team only if they switch it on. */
+export function weeklyOnByDefault(role: Role): boolean {
+  return role === "owner" || role === "admin";
+}
+
+/** `choice` is the person's own setting: null when they never chose, so their role decides. */
+export function wantsWeekly(role: Role, choice: boolean | null): boolean {
+  return choice ?? weeklyOnByDefault(role);
+}
+
+export type WeeklyMember = { userId: string; role: Role; weeklyEmail: boolean | null; email: string | null };
+
+/** The team members who get this charity's weekly email: wanted, with an address. */
+export function weeklyRecipients<T extends WeeklyMember>(members: T[]): T[] {
+  return members.filter((m) => wantsWeekly(m.role, m.weeklyEmail) && Boolean(m.email?.trim()));
+}
+
+// --- The figures ---------------------------------------------------------------------------------------------------
+
+const within = (iso: string | null | undefined, from: string, to: string) => {
+  if (!iso) return false;
+  const t = Date.parse(iso);
+  return t >= Date.parse(from) && t < Date.parse(to);
+};
+
+export type GiftRow = { donor_id: string | null; status: string; amount_cents: number | string; refunded_cents?: number | string | null; paid_at: string | null };
+export type GiftTotals = { cents: number; gifts: number; donors: number };
+
+/** Paid gifts in [from, to), as the Overview counts them: what is left of each, and only gifts with something left. */
+export function giftTotals(rows: GiftRow[], from: string, to: string): GiftTotals {
+  let cents = 0;
+  let gifts = 0;
+  const donors = new Set<string>();
+  for (const g of rows) {
+    if (!countsAsGift(g) || !within(g.paid_at, from, to)) continue;
+    cents += leftCents(g);
+    gifts += 1;
+    if (g.donor_id) donors.add(g.donor_id);
+  }
+  return { cents, gifts, donors: donors.size };
+}
+
+/** Each monthly donation's first payment (paid, refunded or charged back), as the Monthly page dates "started". */
+export function firstPayments(rows: { recurring_id: string | null; status: string; paid_at: string | null }[]): Map<string, string> {
+  const out = new Map<string, string>();
+  for (const r of rows) {
+    if (!r.recurring_id || !r.paid_at || !["paid", "refunded", "charged_back"].includes(r.status)) continue;
+    const had = out.get(r.recurring_id);
+    if (!had || Date.parse(r.paid_at) < Date.parse(had)) out.set(r.recurring_id, r.paid_at);
+  }
+  return out;
+}
+
+export type MonthlyMoveRow = { id: string; status: string; paused_at: string | null; cancelled_at: string | null; updated_at: string | null };
+export type MonthlyMoves = { started: number; stopped: number; paused: number };
+
+/**
+ * Monthly donations that started (first payment), stopped (cancelled or failed for good) or paused in [from, to).
+ * Only monthly donations with a payment count, as on the Monthly page; a stop is dated as the page dates it.
+ */
+export function monthlyMoves(rows: MonthlyMoveRow[], firstPaid: Map<string, string>, from: string, to: string): MonthlyMoves {
+  const out: MonthlyMoves = { started: 0, stopped: 0, paused: 0 };
+  for (const r of rows) {
+    const first = firstPaid.get(r.id);
+    if (!first) continue;
+    if (within(first, from, to) && ["active", "paused", "failed", "cancelled"].includes(r.status)) out.started += 1;
+    if ((r.status === "cancelled" || r.status === "failed") && within(r.cancelled_at ?? r.updated_at, from, to)) out.stopped += 1;
+    if (r.status === "paused" && within(r.paused_at, from, to)) out.paused += 1;
+  }
+  return out;
+}
+
+export type S18aWaiting = { gifts: number; pastYears: number };
+
+/**
+ * Paid gifts that asked for an s18A receipt and aren't on an issued one yet (as the s18A receipts page counts them:
+ * what is left, a gift with nothing left needs none). `pastYears`: of those, from tax years that have ended, so they
+ * are ready for the yearly run; this year's wait until the tax year ends.
+ */
+export function s18aWaiting(
+  gifts: { id: string; status: string; wants_18a: boolean; tax_year: number | null; amount_cents: number | string; refunded_cents?: number | string | null }[],
+  onIssued: Set<string>,
+  currentTaxYear: number,
+): S18aWaiting {
+  const out: S18aWaiting = { gifts: 0, pastYears: 0 };
+  for (const g of gifts) {
+    if (!countsAsGift(g) || !g.wants_18a || g.tax_year === null || onIssued.has(g.id)) continue;
+    out.gifts += 1;
+    if (g.tax_year < currentTaxYear) out.pastYears += 1;
+  }
+  return out;
+}
+
+export type WeekFigures = {
+  week: GiftTotals;
+  before: GiftTotals;
+  monthly: MonthlyMoves;
+  /** Null when the charity doesn't issue s18A receipts through Givezy. */
+  s18a: S18aWaiting | null;
+  /** The last day of this tax year (yyyy-mm-dd): when this year's receipts can be issued after. */
+  taxYearEnd: string;
+};
+
+// --- A quiet week's next step ----------------------------------------------------------------------------------------
+
+export type PageFacts = {
+  logo_path: string | null;
+  cover_path: string | null;
+  description_en: string | null;
+  funds_use_en: string | null;
+};
+export type NextStep = { text: string; url: string };
+
+/** One useful thing to do in a quiet week: finish the page first, otherwise share it. Never a guilt line. */
+export function quietNextStep(page: PageFacts, dashboardUrl: string, publicUrl: string): NextStep {
+  if (!page.logo_path || !page.cover_path) return { text: "Add your logo and a cover photo, so donors recognise you faster", url: `${dashboardUrl}/profile` };
+  if (!page.description_en?.trim() || !page.funds_use_en?.trim()) return { text: "Tell donors what you do and where gifts go, on your page", url: `${dashboardUrl}/profile` };
+  return { text: "Share your Givezy page with your supporters, for example in a WhatsApp group or your newsletter", url: publicUrl };
+}
+
+// --- The email -------------------------------------------------------------------------------------------------------
+
+export const WEEKLY_BUTTON = "Open your dashboard";
+
+/** "Your week on Givezy: R3 400 from 12 gifts", or "Your week on Givezy" when nothing came in. */
+export function weeklySubject(week: GiftTotals): string {
+  return week.gifts > 0 ? `Your week on Givezy: ${formatRand(week.cents)} from ${plural(week.gifts, "gift")}` : "Your week on Givezy";
+}
+
+/** The week before, in plain words, only when it had gifts (no percentages, no "down" to read into). */
+export function beforeLine(before: GiftTotals): string | null {
+  return before.gifts > 0 ? `The week before: ${formatRand(before.cents)} from ${plural(before.gifts, "gift")}.` : null;
+}
+
+export function s18aLine(s: S18aWaiting | null, taxYearEnd: string): string | null {
+  if (!s || s.gifts === 0) return null;
+  if (s.pastYears > 0) return `${plural(s.pastYears, "gift")} from a tax year that has ended ${s.pastYears === 1 ? "is" : "are"} ready for its s18A receipt. Check and approve the list on your s18A receipts page.`;
+  return `This tax year's s18A receipts are issued after it ends on ${dmy(taxYearEnd)}.`;
+}
+
+export type WeeklyEmailArgs = {
+  to: string;
+  charityName: string;
+  week: ReportWeek;
+  figures: WeekFigures;
+  /** Shown only in a quiet week. */
+  nextStep: NextStep;
+  dashboardUrl: string;
+  stopUrl: string;
+  /** The address a mail app's own Unsubscribe posts to (List-Unsubscribe). */
+  oneClickUrl?: string;
+  siteUrl?: string;
+};
+
+/** The rows of the figures card, label and value, in the order they read. */
+export function figureRows(f: WeekFigures): { label: string; value: string }[] {
+  const rows = [
+    { label: "Received", value: formatRand(f.week.cents) },
+    { label: "Paid gifts", value: String(f.week.gifts) },
+    { label: "Donors", value: String(f.week.donors) },
+    { label: "New monthly donations", value: String(f.monthly.started) },
+    { label: "Monthly donations stopped or paused", value: String(f.monthly.stopped + f.monthly.paused) },
+  ];
+  if (f.s18a && f.s18a.gifts > 0) rows.push({ label: "Waiting for an s18A receipt", value: plural(f.s18a.gifts, "gift") });
+  return rows;
+}
+
+/** The plain-text email, and the same words laid out as HTML. */
+export function weeklyEmail(a: WeeklyEmailArgs): EmailMessage {
+  const f = a.figures;
+  const quiet = f.week.gifts === 0;
+  const period = `Monday ${dmy(a.week.start)} to Sunday ${dmy(a.week.end)}`;
+  const intro = `For ${a.charityName}, ${period}.`;
+  const quietLine = "No gifts came in last week.";
+  const before = beforeLine(f.before);
+  const s18a = s18aLine(f.s18a, f.taxYearEnd);
+  const onlyGifts = "Gifts only: contributions to Givezy and card charges aren't included, and refunded gifts are left out.";
+  const footer = `You get this every Monday because you're on the team for ${a.charityName} on Givezy.`;
+  const stopText = `Switch off the weekly email: ${a.stopUrl}`;
+  const button = `${WEEKLY_BUTTON}: ${a.dashboardUrl}`;
+
+  // A quiet week shows only what moved (monthly donations, s18A receipts), not a card of zeros.
+  const quietRows = [
+    ...(f.monthly.started ? [`New monthly donations: ${f.monthly.started}`] : []),
+    ...(f.monthly.stopped + f.monthly.paused ? [`Monthly donations stopped or paused: ${f.monthly.stopped + f.monthly.paused}`] : []),
+    ...(f.s18a && f.s18a.gifts ? [`Waiting for an s18A receipt: ${plural(f.s18a.gifts, "gift")}`] : []),
+  ];
+
+  const text = [
+    intro,
+    "",
+    ...(quiet
+      ? [quietLine, ...(before ? [before] : []), "", ...(quietRows.length ? [...quietRows, ""] : []), ...(s18a ? [s18a, ""] : []), `A next step: ${a.nextStep.text}.`, a.nextStep.url, ""]
+      : [...figureRows(f).map((r) => `${r.label}: ${r.value}`), "", ...(before ? [before] : []), ...(s18a ? [s18a] : []), onlyGifts, ""]),
+    button,
+    "",
+    "The Givezy team",
+    "",
+    footer,
+    stopText,
+  ].join("\n");
+
+  const name = `<span dir="auto" style="font-weight:700">${escHtml(a.charityName)}</span>`;
+  const small = (inner: string) => `<p style="margin:0 0 8px;color:${c.muted};font-size:14px;line-height:1.5">${inner}</p>`;
+  const blocks: string[] = [paragraphHtml(`For ${name}, ${escHtml(period)}.`)];
+  if (quiet) {
+    blocks.push(paragraphHtml(escHtml(quietLine) + (before ? `<br>${linkify(before)}` : "")));
+    if (quietRows.length) blocks.push(cardHtml(quietRows.map((r) => ({ label: r.split(": ")[0], value: r.split(": ").slice(1).join(": ") }))));
+    if (s18a) blocks.push(paragraphHtml(linkify(s18a)));
+    blocks.push(
+      `<p style="margin:0 0 20px;color:${c.ink};font-size:16px;line-height:1.55"><span style="font-family:${emailFonts.heading};font-weight:700">A next step:</span> ${escHtml(a.nextStep.text)}. <a href="${escHtml(a.nextStep.url)}" style="color:${c.blue};text-decoration:underline;word-break:break-word;overflow-wrap:anywhere">${escHtml(nextStepLinkWords(a.nextStep, a.dashboardUrl))}</a></p>`,
+    );
+  } else {
+    blocks.push(cardHtml(figureRows(f)));
+    if (before) blocks.push(paragraphHtml(linkify(before)));
+    if (s18a) blocks.push(paragraphHtml(linkify(s18a)));
+    blocks.push(paragraphHtml(escHtml(onlyGifts), { muted: true }));
+  }
+  blocks.push(buttonHtml(WEEKLY_BUTTON, a.dashboardUrl));
+  blocks.push(paragraphHtml("The Givezy team", { muted: true }));
+  blocks.push(`<hr style="border:0;border-top:1px solid ${c.hairline};margin:8px 0 16px">`);
+  blocks.push(small(`You get this every Monday because you're on the team for ${name} on Givezy.`));
+  blocks.push(small(`<a href="${escHtml(a.stopUrl)}" style="color:${c.muted};text-decoration:underline">Switch off the weekly email</a>. You can switch it back on from your dashboard's Team page.`));
+
+  const subject = weeklySubject(f.week);
+  return {
+    to: a.to,
+    subject,
+    text,
+    html: emailLayout({ title: "Your week on Givezy", siteUrl: a.siteUrl, bodyHtml: blocks.join("\n") }),
+    ...(a.oneClickUrl ? { headers: oneClickStopHeaders(a.oneClickUrl) } : {}),
+  };
+}
+
+/** The link's own words in a quiet week's next step. */
+function nextStepLinkWords(step: NextStep, dashboardUrl: string): string {
+  return step.url.startsWith(`${dashboardUrl}/`) ? "Edit your page" : "See your page";
+}
