+"use server";
+
+import { redirect } from "next/navigation";
+import { stopWeeklyEmail } from "@/lib/charity/weekly-summary-store";
+
+export async function confirmStopWeekly(formData: FormData) {
+  const token = String(formData.get("t") ?? "");
+  const ok = await stopWeeklyEmail(token).catch((e) => {
+    console.error(e);
+    return false;
+  });
+  // "Done" keeps the link's token, and the page checks it really is off before saying so.
+  redirect(ok ? `/weekly-email/stop?t=${encodeURIComponent(token)}&done=1` : `/weekly-email/stop?t=${encodeURIComponent(token)}&error=1`);
+}
