+
+// The address carries the person's link: never pass it on in a Referer header.
+export const metadata: Metadata = { title: "Switch off the weekly email", referrer: "no-referrer" };
+
+/**
+ * From the link at the bottom of the weekly email to a charity's team. Asks first, so an email scanner opening the
+ * link changes nothing. It switches off that person's weekly email for that one charity, and nothing else.
+ */
+export default async function StopWeeklyPage({ searchParams }: PageProps<"/weekly-email/stop">) {
+  const sp = await searchParams;
+  const token = typeof sp.t === "string" ? sp.t : "";
+  // "Done" only after a real stop: "?done=1" alone, or with a link that hasn't stopped anything, asks again instead.
+  const done = sp.done === "1" && token ? await weeklyEmailStopped(token).catch((e) => {
+    console.error(e);
+    return false;
+  }) : false;
+  return (
+    <div className="mx-auto max-w-sm rounded-card border border-border bg-surface p-6">
+      <h1 className="text-xl font-semibold">The weekly email</h1>
+      {done ? (
+        <p className="mt-3 text-sm">Done. You won&apos;t get the Monday email for this charity any more. Everything else stays as it was. You can switch it back on from your dashboard&apos;s Team page.</p>
+      ) : token ? (
+        <SafeForm nothingTyped action={confirmStopWeekly} className="mt-4 space-y-3">
+          <p className="text-sm">Switch off the Monday email with last week&apos;s figures for this charity? Only for you: the rest of your team keeps theirs, and nothing else changes.</p>
+          <input type="hidden" name="t" value={token} />
+          {sp.error === "1" ? <p role="alert" className="text-sm text-danger">That link didn&apos;t work, and nothing was changed. Use the link in your most recent weekly email, or switch it off on your dashboard&apos;s Team page.</p> : null}
+          <PendingButton pendingLabel="Switching off…" className="w-full rounded-control bg-brand px-4 py-2.5 font-medium text-brand-contrast">Switch off the weekly email</PendingButton>
+        </SafeForm>
+      ) : (
+        <p className="mt-3 text-sm text-muted">Open the link at the bottom of a weekly email to switch it off, or use your dashboard&apos;s Team page.</p>
+      )}
+      <Link href="/" className="mt-4 inline-block text-sm text-brand underline">Givezy home</Link>
+    </div>
+  );
+}
