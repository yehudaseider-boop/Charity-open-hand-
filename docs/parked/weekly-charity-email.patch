diff --git a/supabase/migrations/20261122000003_charity_weekly_email.sql b/supabase/migrations/20261122000003_charity_weekly_email.sql
new file mode 100644
index 0000000..71eb4eb
--- /dev/null
+++ b/supabase/migrations/20261122000003_charity_weekly_email.sql
@@ -0,0 +1,52 @@
+-- Givezy: the weekly email to a charity's team (Yehuda, 22/11/2026).
+--
+-- Every Monday morning the daily job emails a charity's owners and admins last week's figures (gifts received, gifts,
+-- donors, monthly donations started, stopped or paused, gifts waiting for an s18A receipt) with one button to the
+-- dashboard. Other team members can switch it on for themselves; owners and admins can switch it off for themselves.
+-- Only approved charities. Off unless WEEKLY_CHARITY_EMAIL=yes on the server. The code runs without this migration
+-- (it then sends nothing and logs one line).
+--
+-- 1. charity_admins.weekly_email: the person's own choice for this charity. Null means they never chose, so their role
+--    decides (on for owner and admin, off for the rest). Written only by the server (service role) after it checked
+--    the signed-in person is changing their own row, or by the stop link in the email. Browsers already can't update
+--    charity_admins (only the platform-admin policy allows it), and this adds no policy.
+-- 2. charity_weekly_emails: the send log. One row per charity, person and week (the Monday it starts), written BEFORE
+--    the email is sent, so a second run of the daily job (or one after a crash part-way) never emails anyone twice
+--    for the same week: the primary key refuses the second claim. A send that surely didn't go deletes its row so a
+--    later run can try again; one that may have gone stays and is never repeated. stop_token_hash is the sha256 of the
+--    random token in that email's "Switch off the weekly email" link, which switches off exactly that person's weekly
+--    email for exactly that charity, and nothing else. No email address, name or amount is stored here.
+--    Server-only: row-level security on, no browser policy, every browser privilege revoked.
+
+-- 1 -----------------------------------------------------------------------------------------------------------
+alter table public.charity_admins add column if not exists weekly_email boolean;
+
+comment on column public.charity_admins.weekly_email is
+  'The person''s own choice for the weekly email (22/11/2026). Null: never chose, so the role decides (on for owner and admin). Server-only writes.';
+
+-- 2 -----------------------------------------------------------------------------------------------------------
+create table public.charity_weekly_emails (
+  charity_id uuid not null references public.charities (id) on delete cascade,
+  user_id uuid not null references auth.users (id) on delete cascade,
+  -- The Monday (Johannesburg) the reported week starts on.
+  week_start date not null constraint charity_weekly_emails_monday check (extract(isodow from week_start) = 1),
+  -- sending: claimed, the send started (if it stays so, it may have gone and is never repeated).
+  outcome text not null default 'sending'
+    constraint charity_weekly_emails_outcome check (outcome in ('sending', 'sent', 'skipped', 'maybe_sent')),
+  stop_token_hash text not null constraint charity_weekly_emails_token check (stop_token_hash ~ '^[0-9a-f]{64}$'),
+  claimed_at timestamptz not null default now(),
+  finished_at timestamptz,
+  primary key (charity_id, user_id, week_start)
+);
+
+create unique index charity_weekly_emails_token on public.charity_weekly_emails (stop_token_hash);
+create index charity_weekly_emails_week on public.charity_weekly_emails (week_start);
+
+alter table public.charity_weekly_emails enable row level security;
+-- No policies: only the service role reaches it.
+revoke all on public.charity_weekly_emails from anon, authenticated;
+create policy no_password_sessions on public.charity_weekly_emails as restrictive for all to authenticated
+  using (public.signed_in_without_password()) with check (public.signed_in_without_password());
+
+comment on table public.charity_weekly_emails is
+  'The weekly email to charities'' teams, one row per charity, person and week, claimed before sending so nobody gets it twice (22/11/2026). Server-only.';
