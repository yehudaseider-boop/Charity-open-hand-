+  return {
+    EmailMaybeSent,
+    maskEmail: (s: string) => s,
+    getEmailTransport: () => ({
+      name: transportName,
+      send: async (m: { to: string; subject: string; text: string; headers?: Record<string, string> }) => {
+        if (sendMode === "surely") throw new Error("refused");
+        if (sendMode === "skipped") return "skipped";
+        sent.push(m);
+        if (sendMode === "maybe") throw new EmailMaybeSent("cut off");
+        return "sent";
