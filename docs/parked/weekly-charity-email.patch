+const gift = (charity_id: string, donor_id: string, amount_cents: number, paid_at: string, extra: Row = {}) => ({ id: `${charity_id}-${donor_id}-${paid_at}`, charity_id, donor_id, status: "paid", amount_cents, refunded_cents: 0, paid_at, recurring_id: null, ...extra });
