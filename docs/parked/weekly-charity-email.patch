+/**
+ * The weekly email's tables (migration 20261122000003, 22/11/2026): one row per charity, person and week, so the same
+ * email can never be claimed twice; only Mondays as a week's start; server-only (no browser reads or writes the send
+ * log); the person's own choice on charity_admins can't be changed from a browser; and the role rule the daily job
+ * applies (owners and admins unless they chose off, others only when they chose on), checked against real rows.
+ * Needs the local Supabase, seeded, with the migration applied.
+ */
+import { afterAll, beforeAll, describe, expect, it } from "vitest";
+import pg from "pg";
+import { wantsWeekly } from "@/lib/charity/weekly-summary";
+import { isRole } from "@/lib/charity/permissions";
+
+const client = new pg.Client({ connectionString: process.env.TEST_DATABASE_URL ?? "postgresql://postgres:postgres@127.0.0.1:54322/postgres" });
+const run = (sql: string, args: unknown[] = []) => client.query(sql, args);
+let ids: Record<string, string>;
+beforeAll(async () => {
+  await client.connect();
+  const one = async (sql: string, a: unknown[]) => (await run(sql, a)).rows[0].id as string;
+  ids = {
+    mealsAdmin: await one("select id from auth.users where email = $1", ["meals.admin@nedivlev.test"]),
+    hallAdmin: await one("select id from auth.users where email = $1", ["hall.admin@nedivlev.test"]),
+    meals: await one("select id from public.charities where slug = $1", ["northcliff-meals-fund"]),
+  };
+});
+afterAll(() => client.end());
+
+async function tx(fn: () => Promise<void>) {
+  await run("begin");
+  try {
+    await fn();
+  } finally {
+    await run("rollback");
+  }
+}
+async function as(who: string | null) {
+  await run("reset role");
+  if (!who) return run("set local role anon");
+  await run("set local role authenticated");
+  await run("select set_config('request.jwt.claims', $1, true)", [JSON.stringify({ sub: who, role: "authenticated", aal: "aal2", amr: [{ method: "otp" }] })]);
+}
+async function refused(sql: string, args: unknown[], pattern: RegExp) {
+  await run("savepoint s");
+  await expect(run(sql, args)).rejects.toThrow(pattern);
+  await run("rollback to savepoint s");
+}
+const claim = "insert into public.charity_weekly_emails (charity_id, user_id, week_start, stop_token_hash) values ($1, $2, $3, $4)";
+
+describe("the weekly email's send log", () => {
+  it("one claim per charity, person and week: a second claim is refused, the next week is fine", async () => {
+    await tx(async () => {
+      await run(claim, [ids.meals, ids.mealsAdmin, "2026-11-16", "a".repeat(64)]);
+      await refused(claim, [ids.meals, ids.mealsAdmin, "2026-11-16", "b".repeat(64)], /duplicate key/);
+      await run(claim, [ids.meals, ids.mealsAdmin, "2026-11-23", "c".repeat(64)]);
+      await run(claim, [ids.meals, ids.hallAdmin, "2026-11-16", "d".repeat(64)]);
+      // A stop token belongs to one email only.
+      await refused(claim, [ids.meals, ids.hallAdmin, "2026-11-23", "a".repeat(64)], /duplicate key/);
+    });
+  });
+
+  it("a week starts on a Monday, and the outcome and token are in shape", async () => {
+    await tx(async () => {
+      await refused(claim, [ids.meals, ids.mealsAdmin, "2026-11-17", "a".repeat(64)], /charity_weekly_emails_monday/);
+      await refused(claim, [ids.meals, ids.mealsAdmin, "2026-11-16", "not-a-hash"], /charity_weekly_emails_token/);
+      await run(claim, [ids.meals, ids.mealsAdmin, "2026-11-16", "a".repeat(64)]);
+      await refused("update public.charity_weekly_emails set outcome = 'maybe' where charity_id = $1", [ids.meals], /charity_weekly_emails_outcome/);
+    });
+  });
+
+  it("is closed to every browser: visitors and the charity's own team can neither read nor write it", async () => {
+    await tx(async () => {
+      await run(claim, [ids.meals, ids.mealsAdmin, "2026-11-16", "a".repeat(64)]);
+      for (const who of [null, ids.mealsAdmin]) {
+        await as(who);
+        await refused("select * from public.charity_weekly_emails", [], /permission denied/);
+        await refused(claim, [ids.meals, ids.mealsAdmin, "2026-11-23", "b".repeat(64)], /permission denied/);
+        await refused("delete from public.charity_weekly_emails", [], /permission denied/);
+        await run("reset role");
+      }
+    });
+  });
+
+  it("has row-level security on and no policy that lets a browser in", async () => {
+    const t = (await run("select relrowsecurity from pg_class where oid = 'public.charity_weekly_emails'::regclass")).rows[0];
+    expect(t.relrowsecurity).toBe(true);
+    const policies = (await run("select policyname, permissive from pg_policies where schemaname = 'public' and tablename = 'charity_weekly_emails'")).rows;
+    expect(policies).toEqual([{ policyname: "no_password_sessions", permissive: "RESTRICTIVE" }]);
+  });
+});
+
+describe("the person's own choice", () => {
+  it("starts unset (the role decides) and can't be changed from a browser, even by that person", async () => {
+    await tx(async () => {
+      const before = (await run("select weekly_email from public.charity_admins where charity_id = $1 and user_id = $2", [ids.meals, ids.mealsAdmin])).rows[0];
+      expect(before.weekly_email).toBeNull();
+      await as(ids.mealsAdmin);
+      // Either refused outright or no row changed: browsers have no update policy on charity_admins.
+      await run("savepoint u");
+      const changed = await run("update public.charity_admins set weekly_email = false where charity_id = $1 and user_id = $2", [ids.meals, ids.mealsAdmin]).then(
+        (r) => r.rowCount,
+        () => 0,
+      );
+      await run("rollback to savepoint u");
+      expect(changed).toBe(0);
+    });
+  });
+
+  it("the daily job's rule on real rows: owners and admins unless off, other roles only when on", async () => {
+    await tx(async () => {
+      const team = (await run("select role::text as role, weekly_email from public.charity_admins where charity_id = $1", [ids.meals])).rows as { role: string; weekly_email: boolean | null }[];
+      expect(team.length).toBeGreaterThan(0);
+      for (const m of team) {
+        const role = isRole(m.role) ? m.role : "viewer";
+        expect(wantsWeekly(role, m.weekly_email)).toBe(m.weekly_email ?? (role === "owner" || role === "admin"));
+      }
+      await run("update public.charity_admins set weekly_email = false where charity_id = $1 and user_id = $2", [ids.meals, ids.mealsAdmin]);
+      const after = (await run("select role::text as role, weekly_email from public.charity_admins where charity_id = $1 and user_id = $2", [ids.meals, ids.mealsAdmin])).rows[0];
+      expect(wantsWeekly(isRole(after.role) ? after.role : "viewer", after.weekly_email)).toBe(false);
+    });
+  });
+
+  it("deleting a charity or a person's sign-in removes their send log rows with them", async () => {
+    const fk = (await run(
+      "select confdeltype from pg_constraint where conrelid = 'public.charity_weekly_emails'::regclass and contype = 'f' order by conname",
+    )).rows.map((r) => r.confdeltype);
+    expect(fk).toEqual(["c", "c"]);
+  });
+});
