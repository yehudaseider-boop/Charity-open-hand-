# Copy to .env.local (never committed). Every EXPO_PUBLIC_ value is built into the app and can be read by
# anyone with the app, so only public values go here: never a secret key.

# The Supabase project (the publishable key, not the secret one).
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# The website, https only (giving, receipts and help links open here).
EXPO_PUBLIC_SITE_URL=
# Giving inside the app (the payment page in an in-app sheet). Off unless "yes"; also needs APP_GIVING=yes
# on the server. Keep off in store builds until Apple and Google confirm in writing (go-live checklist).
EXPO_PUBLIC_IN_APP_GIVING=
# Saving a card for once-off gifts. Off unless "yes"; also needs SAVED_CARDS=yes on the server.
EXPO_PUBLIC_SAVED_CARDS=
# Google and Apple sign-in, once both are set up. Off unless "yes"; email sign-in works without it.
EXPO_PUBLIC_SOCIAL_SIGN_IN=
# Givezy's support address, shown where a donor may need a person. Empty until there is one.
EXPO_PUBLIC_SUPPORT_EMAIL=
