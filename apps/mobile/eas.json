{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "production": {
      "autoIncrement": true,
      "ios": {
        "resourceClass": "default"
      },
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SUPPORT_EMAIL": "hello@givezy.co.za",
        "EXPO_PUBLIC_IN_APP_GIVING": "no",
        "EXPO_PUBLIC_SAVED_CARDS": "no"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {}
    }
  }
}
